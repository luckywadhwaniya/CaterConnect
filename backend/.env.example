DEBUG=False
SECRET_KEY=your-production-secret-key-change-this
# Either use DATABASE_URL (provided by Neon, Supabase, or Render PostgreSQL):
DATABASE_URL=postgres://user:password@host:5432/dbname
# OR individual parameters:
DB_NAME=caterconnect
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app,.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
